{
  "short_name": "ConzaCut",
  "name": "ConzaCut video editor",
  "icons": [
    {
      "src": "favicon.ico",
      "sizes": "64x64 48x48 32x32 24x24 16x16",
      "type": "image/x-icon"
    },
    {
      "src": "icons/android-icon-192x192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "icons/android-icon-512x512.png",
      "type": "image/png",
      "sizes": "512x512"
    }
  ],
  "start_url": "/projects",
  "display": "standalone",
  "theme_color": "#0d0d0d",
  "background_color": "#0d0d0d",
  "id": "/projects",
  "scope": "/",
  "description": "A video editor that runs in the browser and on the desktop.",
  "file_handlers": [
    {
      "action": "/projects",
      "accept": {
        "application/zip": [
          ".opencut.zip",
          ".zip"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
