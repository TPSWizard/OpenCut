        [{
            \"relation\": [\"delegate_permission/common.handle_all_urls\"],
            \"target\": {\"namespace\": \"web\", \"site\": \"https://conzacut.conzahub.com\"}
        }]
    </string>
    <!-- The share_target from apps/web/public/manifest.json, with the action as a full URL. -->
    <string name="share_target" translatable="false">
        {
            \"action\": \"https://conzacut.conzahub.com/share-target\",
            \"method\": \"POST\",
            \"enctype\": \"multipart/form-data\",
            \"params\": {
                \"title\": \"title\",
                \"text\": \"text\",
                \"files\": [{\"name\": \"media\", \"accept\": [\"video/*\", \"image/*\", \"audio/*\"]}]
            }
        }
    </string>
