{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencut-api",
  "main": "src/index.ts",
  // Minimum date required for CloudflareAdapter AoT support
  "compatibility_date": "2025-06-01",
  "observability": { "enabled": true },

  // Every integration below is optional. Without it the matching endpoint
  // answers 503 and the editor degrades gracefully.
  //
  // Sound search (Freesound):   wrangler secret put FREESOUND_API_KEY
  // Stock images and video (Pixabay): wrangler secret put PIXABAY_API_KEY
  //   (Openverse images need no key; the editor calls Openverse directly.)
  //
  // Feedback storage:
  //   "kv_namespaces": [{ "binding": "FEEDBACK", "id": "<namespace id>" }],
  //
  // Per-IP rate limiting for the proxied endpoints:
  //   "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  //
  // Project sharing: bundles in R2 (bucket conzacut-shares, lifecycle rule
  // "expire-shares-7d" deletes shares/ after 7 days and aborts unfinished
  // uploads after 1 day). Uploads need the passcode:
  //   wrangler secret put SHARE_UPLOAD_KEY
  "r2_buckets": [{ "binding": "SHARES", "bucket_name": "conzacut-shares" }],

  // Restrict CORS to the deployed web app by setting CORS_ORIGIN to its origin.
  "vars": {
    "CORS_ORIGIN": "https://conzacut.conzahub.com"
  }
}
