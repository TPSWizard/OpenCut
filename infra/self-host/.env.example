# Copy to .env next to compose.yaml. Every setting is optional; a feature
# whose setting is empty is switched off and says so in the editor.

# Sharing projects by link. Anyone who uploads a share needs this passcode;
# opening a share needs only the link. Use a long random value.
SHARE_UPLOAD_KEY=

# Sound search (https://freesound.org/apiv2/apply).
FREESOUND_API_KEY=

# Stock images and video from Pixabay (https://pixabay.com/api/docs/).
# Openverse images work without a key.
PIXABAY_API_KEY=

# Port on this computer (default 8080).
CONZACUT_PORT=8080

# Your domain, for HTTPS through Caddy (docker compose --profile https up -d).
CONZACUT_DOMAIN=
